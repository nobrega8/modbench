{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modbench",
  "mainBinaryName": "modbench",
  "version": "0.1.0",
  "identifier": "io.github.nobrega8.modbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Modbench",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Modbus TCP/RTU client",
    "longDescription": "Lightweight Modbus TCP/RTU client with device map (.mbm) files and a device library.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
