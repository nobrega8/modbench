{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modbench",
  "mainBinaryName": "modbench",
  "version": "0.2.2",
  "identifier": "io.github.nobrega8.modbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Modbench",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "publisher": "nobrega.me",
    "category": "DeveloperTool",
    "shortDescription": "Modbus TCP/RTU client",
    "longDescription": "Lightweight Modbus TCP/RTU client with device map (.mbmap) files and a device library.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["mbmap"],
        "name": "Modbus Map",
        "description": "Modbus device map",
        "role": "Editor",
        "mimeType": "text/x-mbmap"
      },
      {
        "ext": ["mbsim"],
        "name": "Modbench Simulator Setup",
        "description": "Modbench simulator setup",
        "role": "Editor",
        "mimeType": "application/x-mbsim"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1QTQzNjQyQjY0REQ2MTUKUldRVjFrMjJRamFrZFV2dytkdkdNTEJmbnh3U0tMT1RjWDNjaEFWL3VjUVA4UU13QVV3Z24yazUK",
      "endpoints": [
        "https://github.com/nobrega8/modbench/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
